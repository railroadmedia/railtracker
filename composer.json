{
  "name": "railroad/railtracker",
  "type": "library",
  "description": "Tracks user actions in your application.",
  "keywords": [
    "tracker",
    "pageview",
    "login",
    "tracking"
  ],
  "license": "MIT",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "laravel/framework": "^11.9",
    "guzzlehttp/guzzle": "^7.2",
    "doctrine/dbal": "^3.3",
    "jenssegers/agent": "^2.5",
    "ramsey/uuid": "^4.2.2",
    "predis/predis": "^2.2",
    "symfony/cache": "^6.4",
    "doctrine/orm": "^2.19"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0.1",
    "phpunit/php-code-coverage": "^11.0.1",
    "orchestra/testbench": "^9.2"
  },
  "autoload": {
    "psr-4": {
      "Railroad\\Railtracker\\": "src"
    },
    "files": [
      "src/Helpers/railtracker_helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Railroad\\Railtracker\\Tests\\": "tests/"
    }
  }
}
